<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://apache.org" xmlns:xsi="http://w3.org"
	xsi:schemaLocation="http://apache.org https://apache.org">
    <modelVersion>4.0.0</modelVersion>

    <!-- We add the spring boot parent here so the root knows what the 'spring-boot' plugin is -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version> <!-- Matches your downgrade version from earlier -->
        <relativePath/> 
    </parent>

    <groupId>com.ftn.sbnz</groupId>
    <artifactId>backend-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>backend-parent</name>
    <description>Root orchestrator for Movie Recommender Backend</description>

    <modules>
        <module>model</module>
        <module>kjar</module>
        <module>service</module>
    </modules>

    <build>
        <plugins>
            <!-- This routes the root './mvnw spring-boot:run' command directly into the service folder -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <workingDirectory>${project.basedir}/service</workingDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
