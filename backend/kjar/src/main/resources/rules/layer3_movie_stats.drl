package rules;

import com.ftn.sbnz.kjar.model.facts.UserFact;
import com.ftn.sbnz.kjar.model.facts.MovieFact;
import com.ftn.sbnz.kjar.model.level_2.KeywordStats;
import com.ftn.sbnz.kjar.model.level_3.MovieStats;
import java.util.List;

// A3 – For each unwatched movie, accumulate KeywordStats scores
//      to produce a MovieStats fact
rule "Accumulate MovieStats"
agenda-group "A3"
when
    $user : UserFact(
        $userId : id,
        $watched : watchedMovieIds
    )

    $movie : MovieFact(
        $movieId : id,
        $title : title,
        $keywords : keywords,
        eval(!$watched.contains($movieId))
    )

    $totalScore : Double() from accumulate(
        KeywordStats(
            userId == $userId,
            keyword memberOf $keywords,
            $score : score()
        ),
        sum($score)
    )

    eval($totalScore > 0)
then
    insert(new MovieStats(
        $userId,
        $movieId,
        $title,
        $totalScore
    ));
end
