package rules;

import com.ftn.sbnz.kjar.model.facts.UserFact;
import com.ftn.sbnz.kjar.model.level_1.KeywordInteraction;
import com.ftn.sbnz.kjar.model.level_1.KeywordInteraction.InteractionType;
import com.ftn.sbnz.kjar.model.level_2.KeywordStats;

import java.util.List;
import java.util.Set;

rule "Accumulate KeywordStats"
agenda-group "A2"
when
    $user : UserFact($userId : id)

    $interaction : KeywordInteraction(userId == $userId, $keyword : keyword)

    not KeywordStats(userId == $userId, keyword == $keyword)

    $likes : Long() from accumulate(
        KeywordInteraction(
            userId == $userId,
            keyword == $keyword,
            type == InteractionType.LIKE
        ),
        count(1)
    )

    $dislikes : Long() from accumulate(
        KeywordInteraction(
            userId == $userId,
            keyword == $keyword,
            type == InteractionType.DISLIKE
        ),
        count(1)
    )

    $ratings : List() from accumulate(
        KeywordInteraction(
            userId == $userId,
            keyword == $keyword,
            type == InteractionType.REVIEW,
            $r : rating
        ),
        collectList($r)
    )
then
    int reviewCount = $ratings.size();

    double reviewAvg = reviewCount > 0
        ? $ratings.stream()
            .mapToInt(r -> (Integer) r)
            .average()
            .orElse(0.0)
        : 0.0;

    insert(new KeywordStats(
        $userId,
        $keyword,
        $likes.intValue(),
        $dislikes.intValue(),
        reviewAvg,
        reviewCount
    ));
end